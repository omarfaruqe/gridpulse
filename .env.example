# Copy to .env (git-ignored) and fill in. Never commit real keys.
GRIDPULSE_AESO_API_KEY=

# --- Server deployment only (see docs/deployment.md) ---
# Layers the server override and starts the application services too.
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# COMPOSE_PROFILES=app
# Pick a long random value before the first start, for example: openssl rand -hex 24
# POSTGRES_PASSWORD=
